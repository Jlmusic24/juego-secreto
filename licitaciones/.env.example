# Puerto donde escucha el servidor
PORT=3000
# Ruta de la base de datos (usa un disco persistente en producción)
DB_PATH=./data/licitapp.db
# true en producción (requiere HTTPS). Pon false SOLO para pruebas locales sin HTTPS.
COOKIE_SECURE=true
# Redirige http -> https (actívalo si tu proxy/plataforma pasa X-Forwarded-Proto)
FORCE_HTTPS=true
# Número de proxies delante de la app (1 en Render/Railway/Fly/Caddy). Necesario para IPs y HTTPS correctos.
TRUST_PROXY=1
# Secreto del servidor (mín. 32 caracteres). Si no se define, se genera y guarda en la base de datos.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Orígenes extra permitidos (separados por coma), p. ej. si usas dos dominios
ALLOWED_ORIGINS=
